meta {
  name: Signup owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Owner",
    "email": "bruno-owner-{{stamp}}@mail.com",
    "password": "Password1",
    "confirm": "Password1"
  }
}

script:pre-request {
  // Unique stamp per run so re-runs never collide on emails or shop names.
  // ALWAYS reset (never only-if-unset): Bruno persists collection variables
  // between runs, so a conditional would reuse the previous run's stamp and
  // every signup would 409 as a duplicate.
  bru.setVar("stamp", Date.now().toString(36));
}

script:post-response {
  test("201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("success envelope", function() {
    expect(res.body.success).to.equal(true);
  });
}
