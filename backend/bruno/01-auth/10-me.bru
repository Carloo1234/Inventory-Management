meta {
  name: Get me
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/auth/me
  auth: none
}

script:post-response {
  test("200 with user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.user.email).to.equal(`bruno-owner-${bru.getVar("stamp")}@mail.com`);
  });

  bru.setVar("ownerId", res.body.data.user.id);
  bru.setVar("ownerEmail", res.body.data.user.email);
}
