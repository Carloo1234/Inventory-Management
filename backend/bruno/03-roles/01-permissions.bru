meta {
  name: List permissions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/roles/permissions
  auth: none
}

script:post-response {
  test("200 includes roles create", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.body.data)).to.include("roles:create");
  });
}
