meta {
  name: Rename role persists
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/shops/{{shopId}}/roles/{{roleId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Senior Cashier"
  }
}

script:post-response {
  test("200 wrapped role response", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.role.name).to.equal("Senior Cashier");
  });
}
