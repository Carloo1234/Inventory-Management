meta {
  name: List roles contains Cashier
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/roles
  auth: none
}

script:post-response {
  test("200 contains created role", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.some(x => x.id === bru.getVar("roleId"))).to.equal(true);
  });
}
