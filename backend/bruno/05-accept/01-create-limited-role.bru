meta {
  name: Create invite-read-only role
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/shops/{{shopId}}/roles
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "InviteViewer",
    "permissions": ["invite:read"]
  }
}

script:post-response {
  test("201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  bru.setVar("acceptRoleId", res.body.data.id);
}
