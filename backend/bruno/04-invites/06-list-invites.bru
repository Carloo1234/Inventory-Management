meta {
  name: List invites contains invite
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/invites
  auth: none
}

script:post-response {
  test("200 contains invite", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.some(x => x.id === bru.getVar("inviteId"))).to.equal(true);
  });
}
