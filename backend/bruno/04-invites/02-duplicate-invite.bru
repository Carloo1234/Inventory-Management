meta {
  name: Duplicate invite conflicts
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/shops/{{shopId}}/invites
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "bruno-member-{{stamp}}@mail.com",
    "roleId": "{{roleId}}"
  }
}

script:post-response {
  test("409 conflict", function() {
    expect(res.getStatus()).to.equal(409);
  });
}
