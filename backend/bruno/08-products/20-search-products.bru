meta {
  name: Search products finds shirt
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/products?search=Bruno%20Shirt
  auth: none
}

script:post-response {
  test("200 search hits", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.items.length).to.be.above(0);
  });
}
