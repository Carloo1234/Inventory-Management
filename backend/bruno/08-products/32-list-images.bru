meta {
  name: List product images
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/products/{{productId}}/images
  auth: none
}

script:post-response {
  test("200 contains attached row", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.some(i => i.id === bru.getVar("imageId"))).to.equal(true);
  });
}
