meta {
  name: Barcode exact lookup scanner flow
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/products/variants?barcode=BC{{stamp}}1
  auth: none
}

script:post-response {
  test("200 exactly one row", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.items.length).to.equal(1);
  });
}
