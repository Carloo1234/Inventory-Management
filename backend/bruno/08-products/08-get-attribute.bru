meta {
  name: Get attribute by id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/attributes/{{prodAttrId}}
  auth: none
}

script:post-response {
  test("200 with values", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.values.length).to.equal(2);
  });
}
