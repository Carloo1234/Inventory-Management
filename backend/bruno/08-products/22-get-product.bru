meta {
  name: Get product nests variants
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/products/{{productId}}
  auth: none
}

script:post-response {
  test("200 two variants embedded", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.productVariants.length).to.equal(2);
  });

  bru.setVar("variantId", res.body.data.productVariants[0].id);
}
