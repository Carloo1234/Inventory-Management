meta {
  name: Upload without file rejected
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/shops/{{shopId}}/products/{{productId}}/images/upload
  body: multipartForm
  auth: none
}

body:multipart-form {
  note: just-text-no-file
}

script:post-response {
  test("400 missing file", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
