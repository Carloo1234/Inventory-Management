meta {
  name: Create Color attribute
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/shops/{{shopId}}/attributes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Color"
  }
}

script:post-response {
  test("201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  bru.setVar("prodAttrId", res.body.data.id);
}
