meta {
  name: Long barcode exact lookup
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/products/variants?barcode=LONGBARCODE-{{stamp}}-1234567890
  auth: none
}

script:post-response {
  test("200 exactly one row no length 400", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.items.length).to.equal(1);
  });
}
