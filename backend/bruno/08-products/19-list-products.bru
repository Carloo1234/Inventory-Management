meta {
  name: List products paginated sorted
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/products?page=1&limit=5&sortBy=name&sortOrder=asc
  auth: none
}

script:post-response {
  test("200 envelope with totals", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.total).to.be.above(0);
    expect(res.body.data.items.length).to.be.above(0);
    expect(res.body.data.totalPages).to.be.above(0);
  });
}
