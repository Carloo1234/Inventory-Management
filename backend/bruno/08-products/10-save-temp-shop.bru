meta {
  name: Helper save temp shop id
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/shops/my-shops
  auth: none
}

script:post-response {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  const shops = res.body.data.shops;
  bru.setVar("prodShopBId", shops.find(s => s.name === `Bruno ProdShopB ${bru.getVar("stamp")}`).id);
}
