meta {
  name: Helper value in temp shop
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/shops/{{prodShopBId}}/attributes/{{foreignAttrId}}/values
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "value": "Alien"
  }
}

script:post-response {
  test("201 helper", function() {
    expect(res.getStatus()).to.equal(201);
  });

  bru.setVar("foreignValueId", res.body.data.id);
}
