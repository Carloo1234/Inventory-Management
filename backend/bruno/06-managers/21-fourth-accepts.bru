meta {
  name: Fourth accepts invite
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/shops/{{shopId}}/invites/{{fourthInviteId}}/accept
  auth: none
}

script:post-response {
  test("201 fourth is manager", function() {
    expect(res.getStatus()).to.equal(201);
  });

  bru.setVar("fourthUserId", res.body.data.manager.managerId);
}
