meta {
  name: Verify new role persisted
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/shops/{{shopId}}/managers/{{memberUserId}}
  auth: none
}

script:post-response {
  test("200 staff role held", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.role.id).to.equal(bru.getVar("staffRoleId"));
  });
}
