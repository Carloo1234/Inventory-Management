meta {
  name: Reassign member role
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/shops/{{shopId}}/managers/{{memberUserId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "roleId": "{{staffRoleId}}"
  }
}

script:post-response {
  test("200 reassigned", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
