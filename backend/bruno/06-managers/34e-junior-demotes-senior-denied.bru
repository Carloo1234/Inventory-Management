meta {
  name: Junior demotes senior denied
  type: http
  seq: 54
}

patch {
  url: {{baseUrl}}/shops/{{shopId}}/managers/{{memberUserId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "roleId": "{{staffRoleId}}"
  }
}

script:post-response {
  test("403 rank below your own level names it", function() {
    expect(res.getStatus()).to.equal(403);
    expect(JSON.stringify(res.body)).to.include("below your own level");
  });
}
