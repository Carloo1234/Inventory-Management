meta {
  name: Patch role reports affected managers
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/shops/{{shopId}}/roles/{{acceptRoleId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "InviteViewer2"
  }
}

script:post-response {
  test("200 with affectedManagers count 1", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.role.name).to.equal("InviteViewer2");
    expect(res.body.data.affectedManagers.count).to.equal(1);
    expect(res.body.data.affectedManagers.managerIds.length).to.equal(1);
  });
}
